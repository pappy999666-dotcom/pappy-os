# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production server configuration
PORT=3000
NODE_ENV=production
PAPPY_DATA_DIR="/var/lib/pappy-os"
JSON_LIMIT="25mb"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CORS_ORIGINS="https://your-domain.example"

# Bot repository/service paths mounted on the VPS. Keep secrets/session files out of Git.
PFP_BOT_PATH="/opt/pappy/pappy-pfp"
WHATSAPP_BOT_PATH="/opt/pappy/verbose-fishstick"
SESSION_ENCRYPTION_KEY="replace-with-32-byte-random-secret"
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# External bot service APIs. Use different tokens/owners for each bot.
PAPPY_DEFAULT_OWNER_ID="pappy999666"
PFP_BOT_API_URL="http://127.0.0.1:4101"
PFP_BOT_API_TOKEN="replace-with-pfp-service-token"
PFP_BOT_OWNER_ID="pappy-pfp-owner"
WHATSAPP_BOT_API_URL="http://127.0.0.1:4102"
WHATSAPP_BOT_API_TOKEN="replace-with-whatsapp-service-token"
WHATSAPP_BOT_OWNER_ID="verbose-fishstick-owner"
